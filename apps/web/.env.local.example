# Copy to .env.local for local `npm run dev`, and fill in real values.
# The same shape is used for .env.dev (on the machine running the Dev Docker
# deploy) and .env.prod (on the Prod VM) — see docs/architecture/jenkins-setup.md.
# All of .env.local / .env.dev / .env.prod are gitignored; only this .example ships.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never prefix with NEXT_PUBLIC_, never ship to the client.
# See docs/prd/04-coach-chat.md FR4.
ANTHROPIC_API_KEY=
